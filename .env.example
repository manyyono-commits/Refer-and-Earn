# Copy this file to .env and fill in the values.

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/app_listing_site
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/app_listing_site?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/app_listing_site

# Password for /admin. Use something long and unique.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign admin login tokens (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port for the Express server. Most hosts set this automatically.
PORT=5000

# Leave unset to auto-detect (on in production). Set to false only if the app
# is exposed directly to the internet without a proxy or load balancer.
# TRUST_PROXY=true
