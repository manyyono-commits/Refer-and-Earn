{
  "name": "yono-apps-directory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --prod",
    "seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "seed:site": "node --env-file-if-exists=.env server/scripts/seed.js --site",
    "seed:articles": "node --env-file-if-exists=.env server/scripts/importArticles.js",
    "seed:reset": "node --env-file-if-exists=.env server/scripts/seed.js --reset",
    "lint": "eslint src server --ext .js,.jsx"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.12.1",
    "@reduxjs/toolkit": "^2.13.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=22.9"
  }
}
